# Public configuration only. Never place secrets in VITE_ variables.
VITE_SITE_URL=
VITE_CONTACT_EMAIL=
VITE_PHONE=
# International digits, without + or spaces
VITE_WHATSAPP_NUMBER=
# Official profiles. Each must be an https:// URL on the platform's own domain, or it is not shown.
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_FACEBOOK_URL=
# HTTPS endpoint accepting JSON; configure CORS and server-side spam protection.
VITE_ENQUIRY_ENDPOINT=
