# Chazon — environment configuration.
# Copy to `.env` at the repository root and fill in real values. `.env` is git-ignored: never commit secrets.
# The API reads every variable here; the website and Admin builds only see VITE_-prefixed values,
# which end up in public JavaScript — never put secrets in a VITE_ variable.

# ---------- API (server-side secrets) ----------
# PostgreSQL connection used by the running API (may be a pooled URL, e.g. PgBouncer / Supabase / Neon pooler).
# Optional until the database is ready: without it the API still runs and the ADMIN_EMAIL login works, but leads,
# content and settings need the database (then run `npm run db:migrate`).
DATABASE_URL=
# Direct (non-pooled) connection for migrations. Leave empty to use DATABASE_URL.
DIRECT_URL=
# Random secret, 32+ characters. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Admin login. These credentials live only here: they are checked against this file on sign-in and are never
# stored in the database. Use a strong password (12+ characters). Changing ADMIN_PASSWORD and restarting the API
# signs every session out.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Display name shown in the Admin. Default "Chazon Admin".
ADMIN_NAME=
# Admin session lifetime in hours (sliding). Default 12.
SESSION_TTL_HOURS=12
# Port the API listens on. Default 5000.
PORT=5000
# Number of reverse proxies in front of the API (so rate limits see real client IPs). 0 locally, usually 1 in production.
TRUST_PROXY=0
# Where uploaded images are stored. Default: apps/api/uploads. Use a persistent volume in production.
UPLOAD_DIR=

# Origins (no trailing slash). Development defaults are used when empty; all three are required in production.
# PUBLIC_SITE_URL: allowed origin for enquiry submissions; base URL for sitemap/canonical links.
PUBLIC_SITE_URL=http://localhost:5173
# ADMIN_URL: the only origin allowed to call Admin endpoints (credentialed CORS + CSRF origin check).
ADMIN_URL=http://localhost:5174
# API_URL: public origin of this API; used to build absolute URLs for uploaded images.
API_URL=http://localhost:5000

# ---------- Email (Resend) — optional; enquiries are saved even when email is off or fails ----------
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Chazon <hello@yourdomain.com>"
RESEND_FROM_EMAIL=
# Where new-lead and new-audit notifications are sent.
CHAZON_NOTIFICATION_EMAIL=

# ---------- Website & Admin (public, build-time) ----------
# Demo mode: set to true to explore the Admin (login demo@chazon.local / chazon-demo-2026) and website with built-in
# sample data — no API or database involved. Remove it (or set false) to use the real API.
VITE_DEMO_MODE=
# API origin used by the website and Admin. Defaults to http://localhost:5000 in development.
# In production the Admin and API must be on the same site (e.g. admin.example.com + api.example.com) so the
# session cookie is sent.
VITE_API_URL=
# Production website origin: canonical, Open Graph URL, organization schema, sitemap. Also used for the Admin's
# "View on website" links.
VITE_SITE_URL=
# Fallback contact details, used until they are set in Admin → Website Settings (Admin values take precedence).
VITE_CONTACT_EMAIL=
VITE_PHONE=
# International digits, without + or spaces
VITE_WHATSAPP_NUMBER=
# Official profiles. Each must be an https:// URL on the platform's own domain, or it is not shown.
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_FACEBOOK_URL=
# Optional: send enquiries somewhere other than the Chazon API (HTTPS endpoint accepting JSON).
VITE_ENQUIRY_ENDPOINT=
