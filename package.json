{
  "name": "chazon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,admin,api -c \"#d44720,#3b82f6,#16a34a\" \"npm:dev:web\" \"npm:dev:admin\" \"npm:dev:api\"",
    "dev:web": "npm run dev -w @chazon/web",
    "dev:admin": "npm run dev -w @chazon/admin",
    "dev:api": "npm run dev -w @chazon/api",
    "demo": "node scripts/demo.mjs",
    "demo:reset": "node scripts/demo.mjs --reset",
    "build": "npm run build -w @chazon/api && npm run build -w @chazon/web && npm run build -w @chazon/admin",
    "build:web": "npm run build -w @chazon/web",
    "build:admin": "npm run build -w @chazon/admin",
    "build:api": "npm run build -w @chazon/api",
    "build:vercel": "node scripts/build-vercel.mjs",
    "start:api": "npm run start -w @chazon/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "db:generate": "npm run db:generate -w @chazon/api",
    "db:migrate": "npm run db:migrate -w @chazon/api",
    "db:deploy": "npm run db:deploy -w @chazon/api",
    "db:seed": "npm run db:seed -w @chazon/api",
    "db:seed:demo": "npm run db:seed:demo -w @chazon/api",
    "db:demo:clear": "npm run db:demo:clear -w @chazon/api",
    "db:studio": "npm run db:studio -w @chazon/api",
    "admin:create": "npm run admin:create -w @chazon/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
